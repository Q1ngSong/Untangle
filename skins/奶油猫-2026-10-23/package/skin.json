{
  "format": "untangle-skin",
  "formatVersion": 1,
  "id": "io.untangle.cream-cat",
  "version": "1.0.0",
  "name": {
    "zh-Hans": "奶油猫",
    "en": "Cream Cat"
  },
  "author": "Untangle",
  "license": "CC0-1.0",
  "description": {
    "zh-Hans": "奶茶色的底、粉色肉垫：选中的卡片和当前标签探出一对猫耳，键帽像一排小猫头。",
    "en": "Milk-tea panels and pink paw pads: cat ears peek over the selected card and tab, key caps are kitten heads."
  },
  "appearance": "light",
  "tokens": {
    "color": {
      "panel": "#FFF8F1",
      "edge": "#E8CFBA",
      "ink": "#4A3428",
      "muted": "#7E6455",
      "card": "#FFFFFF",
      "cardEdge": "#F0E0D2",
      "cardShade": "#B4826021",
      "well": "#F6ECE2",
      "accent": "#E0648F",
      "sel": "#FFE7EF",
      "secondary": "#E59A6C",
      "hoverTint": "#F7C9A62e",
      "bar": "#FBF0E6",
      "tab": "#FFFFFF",
      "tabEdge": "#E8CFBA",
      "chip": "#FFFFFF",
      "chipEdge": "#E0C3AB",
      "field": "#FFFFFF",
      "fieldEdge": "#E9D3C1",
      "rowSel": "#FFE7EF",
      "deco": "#F2A0BC",
      "earIn": "#FFD3E1",
      "cardInk": "#4A3428",
      "cardMuted": "#7E6455",
      "chipInk": "#4A3428",
      "fieldInk": "#4A3428",
      "cardHi": "#ffffffb3"
    },
    "font": {
      "ui": {
        "system": true,
        "design": "rounded"
      }
    },
    "image": {
      "ears": "assets/ears.png",
      "tab-ears": "assets/tab-ears.png",
      "key-ears": "assets/key-ears.png",
      "sticker": "assets/sticker.png"
    }
  },
  "editable": [
    {
      "token": "color.accent",
      "label": {
        "zh-Hans": "选中色",
        "en": "Selection"
      }
    },
    {
      "token": "color.secondary",
      "label": {
        "zh-Hans": "悬停色",
        "en": "Hover"
      }
    }
  ],
  "roles": {
    "panel": {
      "shape": {
        "kind": "rounded",
        "radius": 18
      },
      "layers": [
        {
          "type": "fill",
          "color": "$color.panel"
        },
        {
          "type": "stroke",
          "color": "$color.edge",
          "width": 1.5
        }
      ]
    },
    "panel.hints": {
      "add": [
        {
          "type": "image",
          "src": "$image.sticker",
          "mode": "nineSlice",
          "slice": [
            36,
            36,
            0,
            0
          ],
          "scale": 0.5,
          "inset": 0,
          "clip": false,
          "shape": {
            "kind": "rect"
          }
        }
      ]
    },
    "panel.toast": {
      "add": [
        {
          "type": "image",
          "src": "$image.sticker",
          "mode": "nineSlice",
          "slice": [
            36,
            36,
            0,
            0
          ],
          "scale": 0.5,
          "inset": 0,
          "clip": false,
          "shape": {
            "kind": "rect"
          }
        }
      ]
    },
    "tabBar": {
      "shape": {
        "kind": "rounded",
        "radius": 16
      },
      "layers": [
        {
          "type": "fill",
          "color": "$color.bar"
        },
        {
          "type": "stroke",
          "color": "$color.edge",
          "width": 1.5
        }
      ]
    },
    "tab": {
      "shape": {
        "kind": "rounded",
        "radius": 13
      },
      "layers": [],
      "states": {
        "hover": {
          "transition": "hover",
          "add": [
            {
              "type": "fill",
              "color": "$color.hoverTint",
              "inset": [
                3,
                0,
                0,
                0
              ]
            }
          ]
        },
        "incoming": {
          "add": [
            {
              "type": "fill",
              "color": {
                "color": "$color.accent",
                "alpha": 0.12
              },
              "inset": [
                3,
                0,
                0,
                0
              ]
            },
            {
              "type": "stroke",
              "color": "$color.accent",
              "width": 1.5,
              "inset": [
                3,
                0,
                0,
                0
              ],
              "dash": [
                4,
                3
              ]
            }
          ]
        },
        "active": {
          "transition": "select",
          "add": [
            {
              "type": "image",
              "src": "$image.tab-ears",
              "mode": "nineSlice",
              "slice": [
                22,
                52,
                0,
                52
              ],
              "scale": 0.5,
              "inset": -3,
              "clip": false,
              "shape": {
                "kind": "rect"
              },
              "animate": {
                "name": "pop",
                "on": "enter"
              }
            },
            {
              "type": "fill",
              "color": "$color.tab",
              "inset": [
                3,
                0,
                0,
                0
              ]
            },
            {
              "type": "stroke",
              "color": "$color.tabEdge",
              "width": 1,
              "inset": [
                3,
                0,
                0,
                0
              ]
            }
          ]
        }
      }
    },
    "card": {
      "shape": {
        "kind": "rounded",
        "radius": 14
      },
      "layers": [
        {
          "type": "fill",
          "color": "$color.card",
          "inset": [
            6,
            0,
            0,
            0
          ]
        },
        {
          "type": "shadow",
          "color": "$color.cardHi",
          "radius": 0.5,
          "offset": [
            0,
            1.5
          ],
          "inner": true,
          "inset": [
            6,
            0,
            0,
            0
          ]
        },
        {
          "type": "shadow",
          "color": "$color.cardShade",
          "radius": 3,
          "offset": [
            0,
            -2
          ],
          "inner": true,
          "inset": [
            6,
            0,
            0,
            0
          ]
        },
        {
          "type": "stroke",
          "color": "$color.cardEdge",
          "width": 1,
          "inset": [
            6,
            0,
            0,
            0
          ]
        }
      ],
      "states": {
        "hover": {
          "transition": "hover",
          "add": [
            {
              "type": "fill",
              "color": "$color.hoverTint",
              "inset": [
                6,
                0,
                0,
                0
              ]
            },
            {
              "type": "stroke",
              "color": "$color.secondary",
              "width": 1.5,
              "inset": [
                6,
                0,
                0,
                0
              ]
            }
          ]
        },
        "selected": {
          "transition": "select",
          "add": [
            {
              "type": "image",
              "src": "$image.ears",
              "mode": "nineSlice",
              "slice": [
                20,
                52,
                0,
                52
              ],
              "scale": 0.5,
              "inset": 0,
              "clip": false,
              "shape": {
                "kind": "rect"
              },
              "animate": {
                "name": "pop",
                "on": "enter"
              }
            },
            {
              "type": "fill",
              "color": "$color.sel",
              "inset": [
                6,
                0,
                0,
                0
              ]
            },
            {
              "type": "stroke",
              "color": "$color.accent",
              "width": 2,
              "inset": [
                6,
                0,
                0,
                0
              ]
            }
          ]
        }
      }
    },
    "well": {
      "shape": {
        "kind": "rounded",
        "radius": 9
      },
      "layers": [
        {
          "type": "fill",
          "color": "$color.well"
        }
      ]
    },
    "field": {
      "shape": {
        "kind": "rounded",
        "radius": 12
      },
      "layers": [
        {
          "type": "fill",
          "color": "$color.field",
          "inset": [
            8,
            8,
            9,
            8
          ]
        },
        {
          "type": "stroke",
          "color": "$color.fieldEdge",
          "width": 1.25,
          "inset": [
            8,
            8,
            9,
            8
          ]
        }
      ]
    },
    "row": {
      "shape": {
        "kind": "rounded",
        "radius": 12
      },
      "layers": [],
      "states": {
        "selected": {
          "transition": "select",
          "add": [
            {
              "type": "fill",
              "color": "$color.rowSel"
            },
            {
              "type": "stroke",
              "color": "$color.accent",
              "width": 1.5
            }
          ]
        }
      }
    },
    "chip": {
      "shape": {
        "kind": "rounded",
        "radius": 7
      },
      "layers": [
        {
          "type": "image",
          "src": "$image.key-ears",
          "mode": "nineSlice",
          "slice": [
            16,
            34,
            0,
            34
          ],
          "scale": 0.5,
          "inset": -4,
          "clip": false,
          "shape": {
            "kind": "rect"
          }
        },
        {
          "type": "fill",
          "color": "$color.chip"
        },
        {
          "type": "stroke",
          "color": "$color.chipEdge",
          "width": 1.25
        }
      ]
    },
    "control": {
      "shape": {
        "kind": "rounded",
        "radius": 9
      },
      "layers": [
        {
          "type": "fill",
          "color": {
            "color": "$color.cardInk",
            "alpha": 0.1
          }
        }
      ],
      "text": {
        "title": {
          "color": "$color.cardInk"
        }
      },
      "states": {
        "hover": {
          "transition": "hover",
          "replace": [
            {
              "type": "fill",
              "color": {
                "color": "$color.accent",
                "alpha": 0.25
              }
            }
          ]
        }
      }
    },
    "dropTarget": {
      "shape": {
        "kind": "rounded",
        "radius": 16
      },
      "layers": [
        {
          "type": "stroke",
          "color": "$color.accent",
          "width": 2
        }
      ]
    }
  },
  "text": {
    "title": {
      "font": "$font.ui",
      "color": "$color.ink"
    },
    "body": {
      "font": "$font.ui",
      "color": "$color.ink"
    },
    "secondary": {
      "font": "$font.ui",
      "color": "$color.muted"
    },
    "key": {
      "font": "$font.ui",
      "color": "$color.chipInk"
    },
    "field": {
      "font": "$font.ui",
      "color": "$color.fieldInk"
    }
  },
  "motion": {
    "transitions": {
      "select": {
        "curve": "spring",
        "duration": 0.34,
        "bounce": 0.25,
        "slide": true
      },
      "hover": {
        "curve": "smooth",
        "duration": 0.12
      }
    },
    "animations": {
      "pop": {
        "duration": 0.38,
        "keyframes": [
          {
            "t": 0,
            "offset": [
              0,
              5
            ],
            "opacity": 0
          },
          {
            "t": 0.6,
            "offset": [
              0,
              -1.5
            ],
            "opacity": 1
          },
          {
            "t": 1,
            "offset": [
              0,
              0
            ],
            "opacity": 1
          }
        ]
      }
    }
  }
}
