{
  "format": "untangle-skin",
  "formatVersion": 1,
  "id": "io.untangle.bamboo-panda",
  "version": "1.0.0",
  "name": {
    "zh-Hans": "竹林熊猫",
    "en": "Bamboo Panda"
  },
  "author": "Untangle",
  "license": "CC0-1.0",
  "description": {
    "zh-Hans": "米白、墨黑、竹绿：选中的卡片变成熊猫头，键帽戴着黑色圆耳，角上一枝竹叶。",
    "en": "Rice white, ink and bamboo green: the selected card becomes a panda, key caps wear round black ears."
  },
  "appearance": "light",
  "tokens": {
    "color": {
      "panel": "#FAFAF6",
      "edge": "#3A3A35",
      "ink": "#222220",
      "muted": "#62625B",
      "card": "#FFFFFF",
      "cardEdge": "#E0E0D8",
      "cardShade": "#0000000f",
      "well": "#EFEFE8",
      "accent": "#3C984E",
      "sel": "#E5F3E2",
      "secondary": "#86C47C",
      "hoverTint": "#A3D29A2a",
      "bar": "#F2F2EC",
      "tab": "#FFFFFF",
      "tabEdge": "#3A3A35",
      "chip": "#FFFFFF",
      "chipEdge": "#2A2A27",
      "field": "#FFFFFF",
      "fieldEdge": "#D6D6CD",
      "rowSel": "#E5F3E2",
      "ear": "#1D1D1B",
      "blush": "#F6B3BC",
      "leaf": "#4FA45C",
      "leaf2": "#2F7D3E",
      "cardInk": "#222220",
      "cardMuted": "#62625B",
      "chipInk": "#222220",
      "fieldInk": "#222220",
      "cardHi": "#ffffffb3"
    },
    "font": {
      "ui": {
        "system": true,
        "design": "rounded"
      }
    },
    "image": {
      "sticker": "assets/sticker.png"
    }
  },
  "editable": [
    {
      "token": "color.accent",
      "label": {
        "zh-Hans": "选中色",
        "en": "Selection"
      }
    },
    {
      "token": "color.secondary",
      "label": {
        "zh-Hans": "悬停色",
        "en": "Hover"
      }
    },
    {
      "token": "color.ear",
      "label": {
        "zh-Hans": "耳朵",
        "en": "Ears"
      }
    }
  ],
  "roles": {
    "panel": {
      "shape": {
        "kind": "rounded",
        "radius": 18
      },
      "layers": [
        {
          "type": "fill",
          "color": "$color.panel"
        },
        {
          "type": "stroke",
          "color": "$color.edge",
          "width": 1.5
        }
      ]
    },
    "panel.hints": {
      "add": [
        {
          "type": "image",
          "src": "$image.sticker",
          "mode": "nineSlice",
          "slice": [
            36,
            36,
            0,
            0
          ],
          "scale": 0.5,
          "inset": 0,
          "clip": false,
          "shape": {
            "kind": "rect"
          }
        }
      ]
    },
    "panel.toast": {
      "add": [
        {
          "type": "image",
          "src": "$image.sticker",
          "mode": "nineSlice",
          "slice": [
            36,
            36,
            0,
            0
          ],
          "scale": 0.5,
          "inset": 0,
          "clip": false,
          "shape": {
            "kind": "rect"
          }
        }
      ]
    },
    "tabBar": {
      "shape": {
        "kind": "rounded",
        "radius": 16
      },
      "layers": [
        {
          "type": "fill",
          "color": "$color.bar"
        },
        {
          "type": "stroke",
          "color": "$color.edge",
          "width": 1.5
        }
      ]
    },
    "tab": {
      "shape": {
        "kind": "rounded",
        "radius": 13
      },
      "layers": [],
      "states": {
        "hover": {
          "transition": "hover",
          "add": [
            {
              "type": "fill",
              "color": "$color.hoverTint",
              "inset": [
                3,
                0,
                0,
                0
              ]
            }
          ]
        },
        "incoming": {
          "add": [
            {
              "type": "fill",
              "color": {
                "color": "$color.accent",
                "alpha": 0.12
              },
              "inset": [
                3,
                0,
                0,
                0
              ]
            },
            {
              "type": "stroke",
              "color": "$color.accent",
              "width": 1.5,
              "inset": [
                3,
                0,
                0,
                0
              ],
              "dash": [
                4,
                3
              ]
            }
          ]
        },
        "active": {
          "transition": "select",
          "add": [
            {
              "type": "box",
              "anchor": "topLeading",
              "at": [
                11.2,
                1.2
              ],
              "size": [
                9.6,
                9.6
              ],
              "color": "$color.ear",
              "shape": {
                "kind": "rounded",
                "radius": 4.8
              },
              "inset": -3,
              "clip": false
            },
            {
              "type": "box",
              "anchor": "topTrailing",
              "at": [
                11.2,
                1.2
              ],
              "size": [
                9.6,
                9.6
              ],
              "color": "$color.ear",
              "shape": {
                "kind": "rounded",
                "radius": 4.8
              },
              "inset": -3,
              "clip": false
            },
            {
              "type": "fill",
              "color": "$color.tab",
              "inset": [
                3,
                0,
                0,
                0
              ]
            },
            {
              "type": "stroke",
              "color": "$color.tabEdge",
              "width": 1,
              "inset": [
                3,
                0,
                0,
                0
              ]
            }
          ]
        }
      }
    },
    "card": {
      "shape": {
        "kind": "rounded",
        "radius": 14
      },
      "layers": [
        {
          "type": "fill",
          "color": "$color.card",
          "inset": [
            6,
            0,
            0,
            0
          ]
        },
        {
          "type": "shadow",
          "color": "$color.cardHi",
          "radius": 0.5,
          "offset": [
            0,
            1.5
          ],
          "inner": true,
          "inset": [
            6,
            0,
            0,
            0
          ]
        },
        {
          "type": "shadow",
          "color": "$color.cardShade",
          "radius": 3,
          "offset": [
            0,
            -2
          ],
          "inner": true,
          "inset": [
            6,
            0,
            0,
            0
          ]
        },
        {
          "type": "stroke",
          "color": "$color.cardEdge",
          "width": 1,
          "inset": [
            6,
            0,
            0,
            0
          ]
        }
      ],
      "states": {
        "hover": {
          "transition": "hover",
          "add": [
            {
              "type": "fill",
              "color": "$color.hoverTint",
              "inset": [
                6,
                0,
                0,
                0
              ]
            },
            {
              "type": "stroke",
              "color": "$color.secondary",
              "width": 1.5,
              "inset": [
                6,
                0,
                0,
                0
              ]
            }
          ]
        },
        "selected": {
          "transition": "select",
          "add": [
            {
              "type": "box",
              "anchor": "topLeading",
              "at": [
                11,
                0
              ],
              "size": [
                12,
                12
              ],
              "color": "$color.ear",
              "shape": {
                "kind": "rounded",
                "radius": 6.0
              },
              "inset": 0,
              "clip": false
            },
            {
              "type": "box",
              "anchor": "topTrailing",
              "at": [
                11,
                0
              ],
              "size": [
                12,
                12
              ],
              "color": "$color.ear",
              "shape": {
                "kind": "rounded",
                "radius": 6.0
              },
              "inset": 0,
              "clip": false
            },
            {
              "type": "fill",
              "color": "$color.sel",
              "inset": [
                6,
                0,
                0,
                0
              ]
            },
            {
              "type": "stroke",
              "color": "$color.accent",
              "width": 2,
              "inset": [
                6,
                0,
                0,
                0
              ]
            },
            {
              "type": "box",
              "anchor": "bottomLeading",
              "at": [
                12,
                1.9
              ],
              "size": [
                12,
                5.2
              ],
              "color": {
                "color": "$color.blush",
                "alpha": 0.85
              },
              "shape": {
                "kind": "rounded",
                "radius": 2.6
              }
            },
            {
              "type": "box",
              "anchor": "bottomTrailing",
              "at": [
                12,
                1.9
              ],
              "size": [
                12,
                5.2
              ],
              "color": {
                "color": "$color.blush",
                "alpha": 0.85
              },
              "shape": {
                "kind": "rounded",
                "radius": 2.6
              }
            }
          ]
        }
      }
    },
    "well": {
      "shape": {
        "kind": "rounded",
        "radius": 9
      },
      "layers": [
        {
          "type": "fill",
          "color": "$color.well"
        }
      ]
    },
    "field": {
      "shape": {
        "kind": "rounded",
        "radius": 12
      },
      "layers": [
        {
          "type": "fill",
          "color": "$color.field",
          "inset": [
            8,
            8,
            9,
            8
          ]
        },
        {
          "type": "stroke",
          "color": "$color.fieldEdge",
          "width": 1.25,
          "inset": [
            8,
            8,
            9,
            8
          ]
        }
      ]
    },
    "row": {
      "shape": {
        "kind": "rounded",
        "radius": 12
      },
      "layers": [],
      "states": {
        "selected": {
          "transition": "select",
          "add": [
            {
              "type": "fill",
              "color": "$color.rowSel"
            },
            {
              "type": "stroke",
              "color": "$color.accent",
              "width": 1.5
            }
          ]
        }
      }
    },
    "chip": {
      "shape": {
        "kind": "rounded",
        "radius": 7
      },
      "layers": [
        {
          "type": "box",
          "anchor": "topLeading",
          "at": [
            6,
            1.1
          ],
          "size": [
            7.2,
            7.2
          ],
          "color": "$color.ear",
          "shape": {
            "kind": "rounded",
            "radius": 3.6
          },
          "inset": -4,
          "clip": false
        },
        {
          "type": "box",
          "anchor": "topTrailing",
          "at": [
            6,
            1.1
          ],
          "size": [
            7.2,
            7.2
          ],
          "color": "$color.ear",
          "shape": {
            "kind": "rounded",
            "radius": 3.6
          },
          "inset": -4,
          "clip": false
        },
        {
          "type": "fill",
          "color": "$color.chip"
        },
        {
          "type": "stroke",
          "color": "$color.chipEdge",
          "width": 1.25
        }
      ]
    },
    "control": {
      "shape": {
        "kind": "rounded",
        "radius": 9
      },
      "layers": [
        {
          "type": "fill",
          "color": {
            "color": "$color.cardInk",
            "alpha": 0.1
          }
        }
      ],
      "text": {
        "title": {
          "color": "$color.cardInk"
        }
      },
      "states": {
        "hover": {
          "transition": "hover",
          "replace": [
            {
              "type": "fill",
              "color": {
                "color": "$color.accent",
                "alpha": 0.25
              }
            }
          ]
        }
      }
    },
    "dropTarget": {
      "shape": {
        "kind": "rounded",
        "radius": 16
      },
      "layers": [
        {
          "type": "stroke",
          "color": "$color.accent",
          "width": 2
        }
      ]
    }
  },
  "text": {
    "title": {
      "font": "$font.ui",
      "color": "$color.ink"
    },
    "body": {
      "font": "$font.ui",
      "color": "$color.ink"
    },
    "secondary": {
      "font": "$font.ui",
      "color": "$color.muted"
    },
    "key": {
      "font": "$font.ui",
      "color": "$color.chipInk"
    },
    "field": {
      "font": "$font.ui",
      "color": "$color.fieldInk"
    }
  },
  "motion": {
    "transitions": {
      "select": {
        "curve": "smooth",
        "duration": 0.2,
        "slide": true
      },
      "hover": {
        "curve": "smooth",
        "duration": 0.12
      }
    }
  }
}
